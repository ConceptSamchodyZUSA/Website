# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ SECURITY WARNING: Service Role Key should NOT be in frontend!
# Consider moving admin operations to serverless functions
# REACT_APP_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# EmailJS Configuration
# Get these from: https://dashboard.emailjs.com/
REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id
REACT_APP_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key

# Google Analytics (optional)
# Get from: https://analytics.google.com/
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
